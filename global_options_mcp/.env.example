# Zerodha Kite Connect (https://developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=
# Must match the redirect URL in your Kite developer console
KITE_REDIRECT_URL=http://127.0.0.1:5000/
# Written each morning by: python -m global_options_mcp.kite_login --if-needed
KITE_ACCESS_TOKEN=

# Order safety. Keep false until you have tested everything.
LIVE_ORDERS=false
MAX_LOTS_PER_ORDER=2
MAX_ORDER_PREMIUM=50000

# Used for IV / Greeks (annual, decimal)
RISK_FREE_RATE=0.065
